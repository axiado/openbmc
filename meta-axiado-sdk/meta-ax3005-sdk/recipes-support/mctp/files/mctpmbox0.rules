# This rules file contains mctp devices related rules needed to work in hand with mctpd

# Rename every Axiado iRoT MCTP interface from its kernel name mctpirotX to
# mctpmboxX. %n expands to the kernel number (the trailing digits of the kernel
# name), so mctpirot0 -> mctpmbox0, mctpirot1 -> mctpmbox1, and so on. The [0-9]
# in the match guarantees %n is non-empty.
SUBSYSTEM=="net", ACTION=="add", KERNEL=="mctpirot[0-9]*", NAME="mctpmbox%n"

# After the rename udev emits a "move" event; at this point $env{INTERFACE} is the
# new mctpmboxX name, so bring the link up and configure MCTP addressing/routing.
SUBSYSTEM=="net", ACTION=="move", KERNEL=="mctpmbox[0-9]*", RUN+="/bin/sh -c '/usr/bin/mctp link set $env{INTERFACE} up; /usr/bin/mctp link set $env{INTERFACE} network 1; /usr/bin/mctp addr add 11 dev $env{INTERFACE}; /usr/bin/mctp route add 50 via $env{INTERFACE} network 1'"

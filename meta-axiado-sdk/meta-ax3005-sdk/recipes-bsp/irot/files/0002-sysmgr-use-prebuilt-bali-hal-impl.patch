From 9c8ababcf3032367996ac81af05c66e20df6494f Mon Sep 17 00:00:00 2001
From: Kuan-Jui Chiu <kchiu@axiado.com>
Date: Mon, 18 May 2026 00:00:00 +0000
Subject: [PATCH] sysmgr: link against prebuilt HAL from sysroot

Upstream-Status: Inappropriate [Yocto packaging adaptation]
Signed-off-by: Kuan-Jui Chiu <kchiu@axiado.com>
---
 sysmgr/CMakeLists.txt | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/sysmgr/CMakeLists.txt b/sysmgr/CMakeLists.txt
index 20b62cb..7d8d6cd 100644
--- a/sysmgr/CMakeLists.txt
+++ b/sysmgr/CMakeLists.txt
@@ -57,7 +57,18 @@ add_compile_definitions(
 set(COMPILE_ARG_FILE ${AXBASE_PATH}/r52-compile-args.cmake)
 include(${COMPILE_ARG_FILE})
 
-add_subdirectory("${BALI_PLATFORM_PATH}" "${CMAKE_BINARY_DIR}/bali_plat_build")
+# Build the base subtree directly so the kconfig step still produces
+# autoconf.h, which is included by sysmgr/src/openbic/* sources.
+add_subdirectory("${AXBASE_PATH}" "${CMAKE_BINARY_DIR}/axbuild")
+
+set(KW_HAL_PREBUILT_DIR "${CMAKE_SYSROOT}/usr/lib/bali-hal"
+    CACHE PATH "Directory containing the prebuilt kw-hal static library")
+set(KW_HAL_IMPL_LIB "${KW_HAL_PREBUILT_DIR}/libbali-hal-impl.a")
+
+add_library(bali-hal-impl STATIC IMPORTED GLOBAL)
+set_target_properties(bali-hal-impl PROPERTIES
+    IMPORTED_LOCATION "${KW_HAL_IMPL_LIB}"
+    INTERFACE_LINK_LIBRARIES base_hal)
 
 # Disable shadow warning only for ARM_CRx_MPU port.c
 set_source_files_properties(
-- 
2.34.1


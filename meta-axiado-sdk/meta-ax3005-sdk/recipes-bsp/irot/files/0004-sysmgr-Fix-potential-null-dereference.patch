From aa43a7a6361c1d2bda1c2e196738858898fe9332 Mon Sep 17 00:00:00 2001
From: Kuan-Jui Chiu <kchiu@axiado.com>
Date: Wed, 24 Jun 2026 00:42:23 -0700
Subject: [PATCH] sysmgr: Fix potential null dereference

Upstream-Status: Inappropriate [Fix potential null pointer]
Signed-off-by: Kuan-Jui Chiu <kchiu@axiado.com>
---
 sysmgr/src/openbic/mailbox/mctp_mailbox.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/sysmgr/src/openbic/mailbox/mctp_mailbox.c b/sysmgr/src/openbic/mailbox/mctp_mailbox.c
index e730fac..75b5a66 100644
--- a/sysmgr/src/openbic/mailbox/mctp_mailbox.c
+++ b/sysmgr/src/openbic/mailbox/mctp_mailbox.c
@@ -228,8 +228,10 @@ static uint32_t mctp_mailbox_rx(void *mctp_p, uint8_t *buf, uint32_t len, mctp_e
 	mctp_mailbox_ctx_t *ctx = find_ctx_by_inst(mctp_p);
 	if (!ctx || !buf || len == 0)
 	{
-		AX_LOG_ERR("[mctp_mb] len failed\n"); 
-		ax_gicv3_irq_spi_enable(ctx->rx_dev.irq_num);	
+		AX_LOG_ERR("[mctp_mb] len failed\n");
+		if (ctx) {
+			ax_gicv3_irq_spi_enable(ctx->rx_dev.irq_num);
+		}
 		return 0;
 	}
 
-- 
2.34.1


+bool saveCperToFile(std::vector<uint8_t>& data, std::string& fileName)
+{
+    // Save event data to file
+    std::filesystem::path dirName{"/var/cper"};
+    if (!std::filesystem::exists(dirName))
+    {
+        try
+        {
+            std::filesystem::create_directory(dirName);
+        }
+        catch (const std::filesystem::filesystem_error& e)
+        {
+            lg2::error("Failed to create /var/cper directory: {ERROR}", "ERROR",
+                       e.what());
+            return false;
+        }
+    }
+
+    fileName = dirName.string() + "/cper-XXXXXX";
+    auto fd = mkstemp(fileName.data());
+    if (fd < 0)
+    {
+        lg2::error("Failed to generate temp file, error {ERRORNO}", "ERRORNO",
+                   std::strerror(errno));
+        return false;
+    }
+    close(fd);
+
+    if (fileName.empty())
+    {
+        lg2::error("Failed to generate valid temp file name");
+        return false;
+    }
+
+    std::ofstream ofs;
+    ofs.exceptions(std::ofstream::failbit | std::ofstream::badbit |
+                   std::ofstream::eofbit);
+    try
+    {
+        ofs.open(fileName);
+        ofs.write(reinterpret_cast<char*>(data.data()), data.size());
+        ofs.close();
+    }
+    catch (const std::ofstream::failure& e)
+    {
+        lg2::error("Failed to save CPER to '{FILENAME}', error - {ERROR}.",
+                   "FILENAME", fileName, "ERROR", e.what());
+        std::filesystem::remove(fileName);
+        return false;
+    }
+    return true;
+}
+
+bool createCperDumpEntry(ipmi::Context::ptr& ctx, std::string& filePath)
+{
+    faultLogEntryType faultLogEntry;
+
+    ipmi::DbusObjectInfo sbmrCperRecordObject;
+
+    boost::system::error_code ec = ipmi::getDbusObject(
+        ctx, sbmrCperIntf, sbmrCperRoot, sbmrCperMatch, sbmrCperRecordObject);
+    if (ec)
+    {
+        lg2::error("Failed to get sbmrCperRecordObject: {ERROR}", "ERROR",
+                   ec.message());
+        return false;
+    }
+
+    lg2::debug("service = {SERVICE}", "SERVICE", sbmrCperRecordObject.second);
+    lg2::debug("ObjPath = {PATH}", "PATH", sbmrCperRecordObject.first);
+
+    faultLogEntry["Type"] = "CPER";
+    faultLogEntry["PrimaryLogId"] = filePath;
+    faultLogEntry["AdditionalTypeName"] = "CPER";
+
+    ec = ipmi::callDbusMethod(ctx, sbmrCperRecordObject.second.c_str(),
+                              sbmrCperRecordObject.first.c_str(), sbmrCperIntf,
+                              "CreateDump", faultLogEntry);
+    if (ec)
+    {
+        lg2::error("error in create CPER dump entry: {MSG}", "MSG",
+                   ec.message());
+        return false;
+    }
+
+    lg2::info("Successfully created CPER dump entry for file: {FILE}", "FILE",
+              filePath);
+
+    return true;
+}
+
+ipmi::RspType<uint8_t> sendPlatformErrorRecord(ipmi::Context::ptr ctx,
+                                               std::vector<uint8_t>& data)
+{
+    std::string filePath;
+
+    if (data.size() < cperDescriptorSize)
+    {
+        lg2::error("Error: CPER data is empty or too short, size: {SIZE}",
+                   "SIZE", data.size());
+        return ipmi::responseReqDataLenInvalid();
+    }
+
+    if (!saveCperToFile(data, filePath))
+    {
+        return ipmi::responseUnspecifiedError();
+    }
+
+    if (!createCperDumpEntry(ctx, filePath))
+    {
+        return ipmi::responseUnspecifiedError();
+    }
+
+    return ipmi::responseSuccess();
+}

index f4c657f..43e0a84 100644
--- a/include/ipmid/api-types.hpp
+++ b/include/ipmid/api-types.hpp
@@ -85,6 +85,12 @@ using Cmd = uint8_t;
 // ipmi function return the status code
 using Cc = uint8_t;
 
+namespace arm
+{
+constexpr Cmd cmdGetRedfishUuid = 0x1;
+constexpr Cmd cmdGetRedfishPortNumber = 0x2;
+} // namespace arm
+
 // IPMI 2.0 and DCMI 1.5 standard commands, namespaced by NetFn
 // OEM and non-standard commands should be defined where they are used
 namespace app

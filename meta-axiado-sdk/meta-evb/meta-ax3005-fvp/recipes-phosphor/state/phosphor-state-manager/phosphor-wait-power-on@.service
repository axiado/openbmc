[Unit]
Description=Wait for Power%i to turn on
Wants=obmc-power-start-pre@%i.target
After=obmc-power-start-pre@%i.target
Wants=obmc-power-start@%i.target
Before=obmc-power-start@%i.target
After=obmc-power-start@%i.service
Conflicts=obmc-chassis-poweroff@%i.target
ConditionPathExists=!/run/openbmc/chassis@%i-on

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/default/state_config.ini
ExecStart=/bin/sh -c "/usr/sbin/host_check.sh 1"

[Install]
WantedBy=obmc-host-start@%i.target
